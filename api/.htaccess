# Lindungi berkas sensitif di folder api.
Options -Indexes

<FilesMatch "^(config\.php|config\.contoh\.php|bootstrap\.php|error\.log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Berkas SQL (skema & data awal) tidak boleh diunduh dari web.
<FilesMatch "\.sql$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
