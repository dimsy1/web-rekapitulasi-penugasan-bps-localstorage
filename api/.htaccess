# Lindungi berkas sensitif di folder api.
Options -Indexes

<FilesMatch "^(config\.php|config\.contoh\.php|bootstrap\.php|skema\.sql|error\.log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
